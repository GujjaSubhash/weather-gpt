# WeatherGPT environment variables.
# Every entry below mirrors ENV_SCHEMA in lib/env.ts and is tagged with its scope:
#   (server-only) — never sent to the browser. Must NOT carry a NEXT_PUBLIC_ prefix.
#   (public)      — inlined into the client bundle by Next.js. Assume it is public.

# (server-only) OWM weather + geocoding fallback — https://openweathermap.org/api
OPENWEATHER_API_KEY=your_openweather_api_key_here

# (server-only) Primary realtime + nowcast provider — https://app.tomorrow.io/development/keys
TOMORROW_API_KEY=your_tomorrow_io_api_key_here

# (server-only) OPTIONAL — AccuWeather: measured rainfall accumulation, official
# alerts, cross-check against the primary provider. https://developer.accuweather.com
# Leave unset and the app behaves exactly as it does without AccuWeather: no
# accumulation, no official alerts, cross-check reported as "unavailable".
# QUOTA: the free tier is roughly 250 calls/day for the whole key. The provider
# module self-limits to ACCUWEATHER_DAILY_BUDGET (default 180) and stops early if
# the upstream RateLimit-Remaining header drops below 25. Note the name is ALL
# CAPS: Linux hosts read env vars case-sensitively, so AccuWeather_API_KEY would
# be undefined in production even though Windows resolves it locally.
ACCUWEATHER_API_KEY=your_accuweather_api_key_here

# (server-only) OPTIONAL — override the self-imposed daily call ceiling (default 180).
# ACCUWEATHER_DAILY_BUDGET=180

# (server-only) Chat model — https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# (server-only) Web search grounding for chat — https://you.com/platform
YOU_API_KEY=your_you_com_api_key_here

# (public) Firebase web app config — https://console.firebase.google.com
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key_here
# (public) Firebase auth domain
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
# (public) Firebase project id
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
# (public) Firebase storage bucket
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
# (public) Firebase messaging sender id
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
# (public) Firebase web app id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id

# (public) OPTIONAL — CARTO basemap key for the Leaflet map. Without it the map
# still renders using CARTO's public tiles (which may show a watermark); with it
# the dark basemap loads cleanly. https://carto.com/
NEXT_PUBLIC_CARTO_BASEMAP_KEY=your_carto_basemap_key_here
