# WeatherGPT environment variables.
# Every entry below mirrors ENV_SCHEMA in lib/env.ts and is tagged with its scope:
#   (server-only) — never sent to the browser. Must NOT carry a NEXT_PUBLIC_ prefix.
#   (public)      — inlined into the client bundle by Next.js. Assume it is public.

# (server-only) OWM weather + geocoding fallback — https://openweathermap.org/api
OPENWEATHER_API_KEY=your_openweather_api_key_here

# (server-only) Primary realtime + nowcast provider — https://app.tomorrow.io/development/keys
TOMORROW_API_KEY=your_tomorrow_io_api_key_here

# (server-only) Chat model — https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# (server-only) Web search grounding for chat — https://you.com/platform
YOU_API_KEY=your_you_com_api_key_here

# (public) Firebase web app config — https://console.firebase.google.com
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key_here
# (public) Firebase auth domain
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
# (public) Firebase project id
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
# (public) Firebase storage bucket
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
# (public) Firebase messaging sender id
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
# (public) Firebase web app id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id
